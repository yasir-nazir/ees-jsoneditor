{
  "name": "ees-jsoneditor",
  "version": "22.0.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasir-nazir/ees-jsoneditor.git"
  },
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:app": "npm run build:lib && ng build",
    "build:lib": "ng build --project ees-jsoneditor",
    "watch": "npm run build:lib -- --watch",
    "build:full": "npm run build:lib && npm run build:app",
    "publishnpm": "cp README.md projects/ees-jsoneditor/README.md && npm run build:lib && cd dist/ees-jsoneditor && npm publish",
    "unpublish": "npm deprecate -f 'ees-jsoneditor@1.9.3' 'this package has been deprecated'",
    "test": "npm run test:dev && npm run e2e",
    "test:dev": "ng test --project ees-jsoneditor-demo",
    "test:unit": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "ports": "lsof -i tcp:4201",
    "reinstall": "rm package-lock.json && rm -rf node_modules && npm i",
    "rebuildsass": "npm rebuild node-sass"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "jsoneditor": "*",
    "ng-packagr": "^22.2.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "webpack": "^5.88.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.2.7",
    "@angular-eslint/builder": "^22.6.0",
    "@angular-eslint/eslint-plugin": "^22.6.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/schematics": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@types/jasmine": "~5.1.2",
    "@types/jsoneditor": "^9.9.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cpr": "^3.0.1",
    "eslint": "^10.14.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.2",
    "karma": "6.4.2",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "6.0.3"
  },
  "description": "JSON Editor component for Angular 22",
  "main": "./dist/ees-jsoneditor/fesm2022/ees-jsoneditor.mjs",
  "module": "./dist/ees-jsoneditor/fesm2022/ees-jsoneditor.mjs",
  "types": "./dist/ees-jsoneditor/types/ees-jsoneditor.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/ees-jsoneditor/types/ees-jsoneditor.d.ts",
      "default": "./dist/ees-jsoneditor/fesm2022/ees-jsoneditor.mjs"
    }
  },
  "sideEffects": false,
  "author": "Yasir Nazir",
  "bugs": {
    "url": "https://github.com/yasir-nazir/ees-jsoneditor/issues"
  },
  "homepage": "https://github.com/yasir-nazir/ees-jsoneditor#readme"
}